# Copy to .env. The public research mode requires no keys.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
# Hosted deployment: Supabase Connect > Transaction pooler (private URL).
# Empty keeps local SQLite for development.
DATABASE_URL=
DATABASE_NAMESPACE=cd
# Hosted scheduler authentication; at least 32 random characters.
CRON_SECRET=
MARKET_BROKER=upstox
MARKET_STREAM_ENABLED=true
# Kite Connect market-data access is required for authenticated quotes/history/OI.
# Obtain credentials through your Kite Connect account; keep these server-side.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
DAILY_SCAN_ENABLED=true
DAILY_SCAN_TIME=07:00
DAILY_CANDIDATE_LIMIT=18
DAILY_SYMBOLS=RELIANCE,INFY,TCS,HDFCBANK,ICICIBANK,SBIN

# Optional AI tool planner and grounded narrative. Both fields are required.
# Use a model available to your OpenAI API account that supports Responses tool calling.
OPENAI_API_KEY=
OPENAI_MODEL=

# Free read-only Upstox data: set MARKET_BROKER=upstox and generate an Analytics
# Token in your Upstox Developer Apps account. Valid for one year; no orders.
UPSTOX_ANALYTICS_TOKEN=
# Alternative standard Upstox access token, used only if Analytics Token is empty.
UPSTOX_ACCESS_TOKEN=
# Optional overrides for underlying instrument keys, e.g. {"TATAMOTORS":"NSE_EQ|..."}
INSTRUMENTS_FILE=./data/instruments.json
FUNDAMENTALS_FILE=./data/fundamentals.json

# Keep false for local/family use. Public accounts isolate histories and paper ledgers.
PUBLIC_MODE=false
# Exact Vercel frontend origin when frontend and backend are hosted separately.
PUBLIC_ORIGIN=
# Set true only after confirming public data-display and recommendation permissions.
PUBLIC_DATA_APPROVED=false
SECURE_COOKIES=true
ALLOW_REGISTRATION=true
MAX_USERS=100
DAILY_RESEARCH_LIMIT=12
AI_DAILY_CALL_LIMIT=100

# FYERS alternative: MARKET_BROKER=fyers. App ID and daily access token required.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
